# ============================================================
# Maven / Java
# ============================================================

# Maven build output
/target
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Compiled classes
*.class

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven wrapper
.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# Build tools
build/
out/

